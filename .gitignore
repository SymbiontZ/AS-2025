# Env files (no commitear secretos)
**/.env
!**/.env.example
**/rndc.key

# Docker volumes (por si los mapeas a carpetas locales)
**/*mysql*data*/


# Logs y dumps locales (si los guardas en tu máquina)
**/logs/*
**/dumps/*

**/backups/*

# SSH service runtime/generated state
stacks/services/ssh/config/.bash_history
stacks/services/ssh/config/logs/**
stacks/services/ssh/config/ssh_host_keys/**
stacks/services/ssh/config/.ssh/authorized_keys

stacks/development/ssh-2fa/users.conf

# Backups created by SSH helper scripts
stacks/services/ssh/config/.ssh/*.bak.*

# WireGuard/VPN generated state and secrets
stacks/vpn/vpn-config/.donoteditthisfile
stacks/vpn/vpn-config/server/
stacks/vpn/vpn-config/wg_confs/
stacks/vpn/vpn-config/peer*/
stacks/vpn/vpn-config/profiles/*.conf
stacks/vpn/vpn-config/**/*.png
stacks/vpn/vpn-config/coredns/