# WireGuard server endpoint reachable by clients
SERVERURL=TU_IP_PUBLICA_O_LOCAL_AQUI
SERVERPORT=51820

# Number of client profiles to generate automatically (peer1, peer2, ...)
PEERS=0

# DNS server pushed to VPN clients
PEERDNS=172.20.0.10

# VPN tunnel subnet (clients are pinned manually in /config/wg_confs and /config/peer*)
INTERNAL_SUBNET=172.10.0.0/24

# Routes advertised to clients through the tunnel
ALLOWEDIPS=172.0.0.0/8

# Keepalive for NATed clients
PERSISTENTKEEPALIVE_PEERS=all

# Runtime defaults
PUID=1000
PGID=1000
TZ=Europe/Madrid
LOG_CONFS=true