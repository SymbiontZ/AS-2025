# Endpoint del servidor WireGuard alcanzable por los clientes
SERVERURL=TU_IP_PUBLICA_O_LOCAL_AQUI
SERVERPORT=51820

# Numero de perfiles cliente a generar automaticamente (peer1, peer2, ...)
PEERS=0

# Servidor DNS entregado a los clientes VPN
PEERDNS=172.20.0.10

# Subred del tunel VPN (los clientes se fijan manualmente en /config/wg_confs y /config/peer*)
INTERNAL_SUBNET=172.10.0.0/24

# Rutas anunciadas a los clientes a traves del tunel
ALLOWEDIPS=172.0.0.0/8

# Keepalive para clientes detras de NAT
PERSISTENTKEEPALIVE_PEERS=all

# Valores por defecto de ejecucion
PUID=1000
PGID=1000
TZ=Europe/Madrid
LOG_CONFS=true