# ─── Identidad del servidor ───────────────────────────────────────────────────
myhostname = mail.empresa.local
mydomain   = empresa.local
myorigin   = $mydomain

# ─── Redes e interfaces ───────────────────────────────────────────────────────
inet_interfaces = all
inet_protocols  = ipv4

# ─── Dominios locales ─────────────────────────────────────────────────────────
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# ─── Relay: cerrado por defecto (anti-relay abierto) ──────────────────────────
mynetworks = 127.0.0.0/8
relayhost  =

# Rechazar relay para orígenes externos
smtpd_relay_restrictions =
    permit_mynetworks,
    reject_unauth_destination

# ─── Formato de buzones (Maildir, compatible con Dovecot) ─────────────────────
home_mailbox = Maildir/

# ─── TLS (habilitado STARTTLS) ────────────────────────────────────────────────
smtpd_use_tls = yes
smtpd_tls_cert_file = /etc/ssl/certs/mail.crt
smtpd_tls_key_file = /etc/ssl/private/mail.key
smtpd_tls_security_level = may
smtp_tls_security_level = may

# ─── Logs detallados ─────────────────────────────────────────────────────────
debug_peer_level   = 2
smtp_tls_loglevel  = 0

# ─── Límites ─────────────────────────────────────────────────────────────────
message_size_limit  = 10240000
mailbox_size_limit  = 51200000
