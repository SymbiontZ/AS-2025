$TTL 86400
@ IN SOA dns.empresa.local. admin.empresa.local. (
        1               ; Serial
        604800          ; Refresh
        86400           ; Retry
        694800          ; Expire
        86400 )         ; TTL minimo

@ IN NS dns.empresa.local.

; --- Reverse records for 172.30.0.0/24 ---
10 IN PTR prod-web.empresa.local.
20 IN PTR prod-postgres.empresa.local.
