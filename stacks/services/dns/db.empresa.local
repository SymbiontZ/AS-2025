$TTL 86400
@ IN SOA dns.empresa.local. admin.empresa.local. (
        4               ; Serial
        604800          ; Refresh
        86400           ; Retry
        694800          ; Expire
        86400 )         ; TTL mínimo

@ IN NS dns.empresa.local.

; --- VPN Network (172.10.0.10/24) ---
vpn IN A 172.10.0.10

; --- Services Network (172.20.0.0/24) ---
dns IN A 172.20.0.10
nas IN A 172.20.0.30
ssh-svc IN A 172.20.0.40

; --- Production Network (172.30.0.0/24) ---
prod-web IN A 172.30.0.10
prod-postgres IN A 172.30.0.20

; --- Development Network (172.40.0.0/24) ---
dev-web IN A 172.40.0.10
dev-mysql IN A 172.40.0.20
dev-ssh IN A 172.40.0.30

